# ========== apps/server/.env ==========
NODE_ENV=development
PORT=3000
# Optional. HOST defaults to 127.0.0.1 (this computer only); the Docker image sets 0.0.0.0
# HOST=127.0.0.1
# LOG_LEVEL=info
# Optional comma-separated browser origins allowed to call the API (defaults to the desktop app)
# CORS_ORIGINS=http://tauri.localhost,http://127.0.0.1:1420
PUBLIC_URL=https://yourname.duckdns.org
APP_TIMEZONE=Asia/Kolkata

# Supabase (server only)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
# JWTs are verified with the JWKS at $SUPABASE_URL/auth/v1/.well-known/jwks.json (no JWT secret needed)
# Session pooler (IPv4). Copy from Supabase -> Connect -> Session pooler.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# OmniRoute (private, Docker network)
OMNIROUTE_URL=http://omniroute:20128/v1
OMNIROUTE_ASSISTANT_KEY=replace-me

# Google OAuth (Web application client)
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=https://yourname.duckdns.org/api/v1/google/callback

# 32-byte key for encrypting Google tokens (base64)
TOKEN_ENCRYPTION_KEY=replace-me

# ========== apps/desktop/.env ==========
# Required. Use the local server while developing; the deployed address is
# https://<your-name>.duckdns.org/api/v1
VITE_API_URL=http://127.0.0.1:3000/api/v1
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=replace-me

# ========== infra/.env (server host) ==========
DUCKDNS_DOMAIN=yourname
DUCKDNS_TOKEN=replace-me
OCI_BACKUP_BUCKET=personal-os-backups

# Backups (pg_dump in Docker + rclone to Oracle Object Storage S3-compatible API)
# Session pooler URL, same as apps/server DATABASE_URL
BACKUP_DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Must match the Supabase project's Postgres major version
PG_MAJOR_VERSION=17
BACKUP_RETENTION_DAYS=30
OCI_REGION=ap-mumbai-1
# https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_S3_ENDPOINT=https://namespace.compat.objectstorage.ap-mumbai-1.oraclecloud.com
# Customer Secret Key (Oracle Console -> My profile -> Customer secret keys)
OCI_S3_ACCESS_KEY=replace-me
OCI_S3_SECRET_KEY=replace-me
