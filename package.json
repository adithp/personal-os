{
  "name": "personal-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev:desktop": "pnpm --filter @personal-os/desktop dev",
    "dev:server": "pnpm --filter @personal-os/server dev",
    "dev:ui": "pnpm --filter @personal-os/ui gallery",
    "build:desktop": "pnpm --filter @personal-os/desktop tauri build",
    "build": "pnpm typecheck && pnpm -r --if-present build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:check": "node scripts/docs-check.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs || exit 0",
    "db:generate": "pnpm --filter @personal-os/db db:generate",
    "db:migrate": "pnpm --filter @personal-os/db db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
